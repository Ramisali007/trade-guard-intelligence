{
  "name": "docuintel-backend",
  "version": "1.0.0",
  "private": true,
  "description": "DocuIntel — AI document intelligence API. Extraction, structural segmentation, chunked AI classification, aggregation and TXT report generation.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
