    "typecheck": "tsc -p tsconfig.scripts.json",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.1",
    "mongodb": "^7.5.0",
    "multer": "^2.2.0",
    "node-html-parser": "^9.0.1",
    "pdfjs-dist": "^3.11.174",
    "word-extractor": "^1.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  }
