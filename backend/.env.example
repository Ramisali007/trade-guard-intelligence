# ---------------------------------------------------------------------------------------------
# DocuIntel AI Backend Configuration Example
# Copy this file to .env and fill in your credentials
# ---------------------------------------------------------------------------------------------

# ------------------------------------------------------------------ runtime
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------ HTTP server
# Loopback by default. Set 0.0.0.0 (and NODE_ENV=production) only behind a reverse proxy.
HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
BODY_LIMIT=1mb
TRUST_PROXY=false
# Resolvers for SRV lookups (mongodb+srv:// URIs). Defaults to public resolvers (8.8.8.8,8.8.4.4,1.1.1.1).
# Set to "system" on networks with internal DNS names, or give your own comma-separated list.
DNS_SERVERS=

# ------------------------------------------------------------------ Active AI Provider
# Choose from: openai-compatible (e.g. Groq, OpenRouter, Together), openai, anthropic, or heuristic (local)
AI_PROVIDER=openai-compatible
# heuristic = nothing leaves this machine: no document text is sent to any model, including by the chat assistant.
# For anthropic set ANTHROPIC_API_KEY and, optionally, AI_MODEL (default claude-opus-5-5) and AI_EFFORT (default low).
OPENAI_API_KEY=your_groq_or_openai_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
AI_MAX_OUTPUT_TOKENS=8000

# ------------------------------------------------------------------ Authentication & Security
# Token signing key, at least 32 characters. REQUIRED when NODE_ENV=production (the server refuses to start
# without it). Example values and short values are ignored. Generate with: openssl rand -hex 32
AUTH_SECRET=
AUTH_SESSION_HOURS=12
# Key for the audit hash chains (HMAC), at least 32 characters, kept outside the database and different from
# AUTH_SECRET. With it, rewriting audit history consistently needs the key; without it the chains are plain
# SHA-256. Generate with: openssl rand -hex 32
AUDIT_HMAC_KEY=
# scrypt cost as log2(N) for password hashing (default 17, the OWASP floor). Existing hashes keep verifying.
# AUTH_SCRYPT_LOG2_N=17
# Integration key for server-to-server calls (X-API-Key header), at least 24 characters. Leave empty to disable.
# Generate with: openssl rand -hex 24
API_SECRET_KEY=
# Provisioned users: JSON array of {"email","name","role","institution","passwordHash"}.
# role: CHIEF_COMPLIANCE_OFFICER | TBML_RISK_ANALYST | TRADE_AUDITOR | OPERATIONS_DESK
# Hash a password with: npm run hash-password -- '<password of 12+ characters>'
AUTH_USERS=
# One-click demo accounts (their password is in the README). Default: on only for NODE_ENV=development/test
# while HOST is loopback; everywhere else off unless you set this to true. Keep it false on a shared server.
# ENABLE_DEMO_LOGIN=false
# Password for the demo officers on the email/password form (default outside production: TradeGuard-Demo-2026).
DEMO_ACCOUNT_PASSWORD=

# ------------------------------------------------------------------ Storage & Cache
STORAGE_DRIVER=memory
# With STORAGE_DRIVER=mongo: may an unreachable database be replaced by memory at start-up?
# Defaults to true outside production and false in production (the server refuses to start).
# STORAGE_ALLOW_MEMORY_FALLBACK=false
PERSIST_TO_DISK=true
MONGODB_URI=mongodb://127.0.0.1:27017/docuintel
MONGODB_CLOUD_URI=
ENABLE_DUAL_SYNC=false
UPLOAD_DIR=storage/uploads
DATA_DIR=storage/data
# Images pulled out of uploaded documents (stamps, signatures, pictures), one folder per document.
IMAGES_DIR=storage/images
# Local mirror of the compliance store (sanctions lists, benchmarks, ports, FX).
COMPLIANCE_DIR=storage/compliance
MAX_FILE_SIZE_MB=50
# A longer PDF is refused with a clear message; every document read has a wall-clock ceiling.
MAX_DOCUMENT_PAGES=400
EXTRACTION_TIMEOUT_MS=180000
FILE_RETENTION_MINUTES=120
CLEANUP_INTERVAL_MINUTES=15

# ------------------------------------------------------------------ Large Document Processing
AI_UNITS_PER_BATCH=10
AI_BATCH_TOKEN_BUDGET=2500
AI_CONCURRENCY=4
JOB_CONCURRENCY=2
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=60000
# Longest a single large call (whole-document extraction / pre-shipment review) may take.
AI_LONG_TIMEOUT_MS=90000
# Least time between large pre-shipment calls; keeps free-tier models (~15 requests/min) under their limit. 0 = off.
AI_MIN_GAP_MS=4000
MAX_ANALYSIS_UNITS=4000
MIN_UNIT_CHARS=25
MAX_UNIT_CHARS=4000
AI_ENABLE_SUMMARY=true

# ------------------------------------------------------------------ Pricing
# Indicative prices from public search results when no curated benchmark exists.
# Off by default: figures are unverified (never used for findings) and add network latency.
ENABLE_WEB_PRICE_LOOKUP=false

# ------------------------------------------------------------------ External verification (checks against official sources)
# Switch the whole module off (nothing is checked, nothing is shown as checked).
EXTERNAL_VERIFICATION_ENABLED=true
# true = never fetch any external source (air-gapped deployments, test suites). A cached copy is still used if present.
EXTERNAL_SOURCES_OFFLINE=false
# What a rule does while the bank has not approved it as a control:
#   DEMO_ENFORCE = it can hold a case, and every finding says it is a demonstration (default outside production)
#   SHADOW       = it is shown and labelled advisory, and never holds a case (default in production)
VERIFICATION_UNAPPROVED_RULE_MODE=
# Comma-separated source ids whose unavailability must hold an approval once the rule that depends on them is an
# approved control (for example UN-HS-REFERENCE,PAKISTAN-CUSTOMS-TARIFF). Empty = no source is mandatory: an
# unavailable source is a visible warning and the check stays marked incomplete.
VERIFICATION_MANDATORY_SOURCES=

# ------------------------------------------------------------------ Price comparison thresholds
# A JSON file of category thresholds the bank has approved (see docs/PRICING_FRAMEWORK.md). Each entry needs an HS
# prefix, the two percentages, a written methodology, who approved it and when; an entry without them is ignored and
# reported. Unset: the platform default (+30% / -28%) applies and every result says it is an unapproved screening indicator.
PRICING_POLICY_FILE=

# ------------------------------------------------------------------ Pre-shipment scrutiny
# true (default): the pre-shipment scrutiny relies on the AI model's reading of the documents, never the local parser,
# and a case cannot be approved until the model has scrutinised every current document and compared them with each
# other. Set false only where no model exists, such as the automated tests.
PRESHIPMENT_REQUIRE_AI=true

# ------------------------------------------------------------------ Database name
# Database used when STORAGE_DRIVER=mongo (the name in MONGODB_URI is not used for this).
MONGODB_DB=docuintel

# ------------------------------------------------------------------ AI tuning (defaults shown; usually leave unset)
# For AI_PROVIDER=anthropic: AI_MODEL (default claude-opus-5-5) and AI_EFFORT (low | medium | high | xhigh | max).
# AI_MODEL=
# AI_EFFORT=low
# AI_UNIT_MAX_OUTPUT_TOKENS=2500
# AI_SUMMARY_MAX_OUTPUT_TOKENS=1800
# The provider's tokens-per-minute limit, and the point at which requests start to be slowed down.
# AI_TPM_LIMIT=1000000
# AI_SAFE_TPM_THRESHOLD=800000

# ------------------------------------------------------------------ Scanned documents and images (defaults shown)
# OCR_ENABLED=true
# VISION_ENABLED=true
# SCANNED_TEXT_THRESHOLD_CHARS=40
# MIN_IMAGE_DIMENSION=30
# MIN_IMAGE_AREA=1000

# ------------------------------------------------------------------ Sanctions (optional)
# With a key, each name is first checked against the OpenSanctions match API; if that call fails, or finds nothing,
# the local compliance store is used. Unset: local store only.
OPENSANCTIONS_API_KEY=

# ------------------------------------------------------------------ reCAPTCHA on the sign-in (optional)
# Google reCAPTCHA v2 ("I'm not a robot"). On only when BOTH keys are set; without them the sign-in is unchanged.
# Create keys at https://www.google.com/recaptcha/admin (type: reCAPTCHA v2 checkbox, add your site's domain).
# The site key is public and goes to the browser; the secret key stays on the server (keep it in a secret store).
# For local development Google publishes test keys that always pass (the widget says "for testing purposes only"):
#   RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Never use the test keys in production: they stop nothing.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ------------------------------------------------------------------ host payload (pre-shipment approval -> host system)
# When a trade maker approves a request, a payload PDF is made and stored; "Send to host" creates its TI reference.
# The PDF carries a link the host opens to view or download it; the link holds an unguessable token, so keep this address private.
# The address the HOST can reach this API at (no trailing slash). Default: http://localhost:<PORT>, which works on one machine only.
PUBLIC_BASE_URL=
# Prefix of the TI reference: PREFIX-YEAR-NNNNNN (default TI).
HOST_TI_PREFIX=TI
# Optional. Where "Send to host" posts the payload details as JSON. Unset: the payload and its link are recorded for the host to fetch.
HOST_DELIVERY_URL=
HOST_DELIVERY_TOKEN=
