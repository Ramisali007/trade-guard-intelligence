# ---------------------------------------------------------------------------------------------
# DocuIntel AI Backend Configuration Example
# Copy this file to .env and fill in your credentials
# ---------------------------------------------------------------------------------------------

# ------------------------------------------------------------------ runtime
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------ HTTP server
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
BODY_LIMIT=1mb
TRUST_PROXY=false

# ------------------------------------------------------------------ Active AI Provider
# Choose from: openai-compatible (e.g. Groq, OpenRouter, Together), openai, anthropic, or heuristic (local)
AI_PROVIDER=openai-compatible
OPENAI_API_KEY=your_groq_or_openai_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
AI_MAX_OUTPUT_TOKENS=8000

# ------------------------------------------------------------------ Storage & Cache
STORAGE_DRIVER=memory
PERSIST_TO_DISK=true
UPLOAD_DIR=storage/uploads
DATA_DIR=storage/data
MAX_FILE_SIZE_MB=50
FILE_RETENTION_MINUTES=120
CLEANUP_INTERVAL_MINUTES=15

# ------------------------------------------------------------------ Large Document Processing
AI_UNITS_PER_BATCH=10
AI_BATCH_TOKEN_BUDGET=2500
AI_CONCURRENCY=4
JOB_CONCURRENCY=2
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=60000
MAX_ANALYSIS_UNITS=4000
MIN_UNIT_CHARS=25
MAX_UNIT_CHARS=4000
AI_ENABLE_SUMMARY=true